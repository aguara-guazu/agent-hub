{
  "name": "agent-hub",
  "version": "0.2.0",
  "private": true,
  "description": "Un solo hub para los MCP servers y skills de tus agentes: Claude Code, Codex CLI, Gemini CLI y Kiro.",
  "author": {
    "name": "Luciano Serra",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/aguara-guazu/agent-hub",
  "type": "module",
  "main": "desktop/dist/entry.js",
  "workspaces": [
    "packages/*",
    "desktop",
    "frontend",
    "testdata"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && npm run dev --workspace @agenthub/desktop",
    "start": "npm run start --workspace @agenthub/daemon",
    "agenthub": "tsx packages/daemon/src/cli.ts",
    "seed": "tsx packages/core/src/seed.ts",
    "test": "vitest run --exclude '**/dist/**' packages desktop/src testdata/src && npm run test --workspace @agenthub/frontend",
    "test:unit": "npm test",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "typecheck": "tsc -b && npm run typecheck --workspace @agenthub/frontend",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@agenthub/core": "0.2.0",
    "@agenthub/daemon": "0.2.0",
    "@agenthub/gateway": "0.2.0",
    "@agenthub/shared": "0.2.0",
    "@fastify/cors": "11.1.0",
    "@fastify/static": "10.1.3",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@node-rs/argon2": "2.0.2",
    "fastify": "5.12.3",
    "jose": "6.1.0",
    "yaml": "2.9.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "9.35.0",
    "jsdom": "25.0.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "6.4.3",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild": true
  }
}
